# Google API Configuration (for Gemini)
GOOGLE_API_KEY=your-google_api_key-here

# Tavily API Configuration (for web search)
TAVILY_API_KEY=your-tavily_api_key-here

# Ollama Configuration
OLLAMA_BASE_URL=http://172.24.88.88:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# LLM Model Configuration
CHAT_MODEL_NAME=gemini-2.5-flash
CHAT_MODEL_TEMPERATURE=0.7
INGESTION_MODEL_NAME=gemini-2.5-flash
INGESTION_MODEL_TEMPERATURE=0.7

# Database Configuration
DATABASE_URL=postgresql://zakerly_user:zakerly_password@postgres:5432/zakerly_db

# Redis Configuration
REDIS_URL=redis://redis:6379


# Service URLs (for development)
INGESTION_SERVICE_URL=http://localhost:8008
CHAT_SERVICE_URL=http://localhost:8009

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8007

# Security (change in production)
JWT_SECRET=change-me-to-a-long-random-string
# ENCRYPTION_KEY=your_encryption_key_here

